{
  "name": "meet-poc-rebuild",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build -w backend && npm run build -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run start -w frontend -- --host 127.0.0.1 --port 4711 --proxy-config proxy.conf.json",
    "serve": "node scripts/serve.js",
    "e2e:webserver": "node scripts/e2e-webserver.js",
    "test:e2e:b3": "npm test -w e2e -- e2e/tests/b3-shell-auth",
    "seed": "npm run seed -w backend",
    "migrate-from-json": "npm run migrate-from-json -w backend",
    "test": "npm test -w backend"
  },
  "dependencies": {
    "http-proxy": "^1.18.1"
  }
}
